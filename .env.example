# [OpenAI API 설정]
# OPENAI_API_KEY: 온톨로지 빌더 및 LLM 클라이언트가 OpenAI API를 호출하기 위해 사용하는 인증 키입니다.
OPENAI_API_KEY=sk-your-key-here

# [데이터베이스 접속 정보]
# Docker 컨테이너 내에서 `app` 컨테이너가 `database` 컨테이너와 통신하기 위해 필요한 로컬 네트워크 도메인 및 포트 설정입니다.
# POSTGRES_HOST: docker-compose.yml에 명시된 서비스 이름(database)을 넘겨주면, Docker 내장 DNS가 자동으로 IP 주소를 찾아 라우팅해 줍니다.
# Docker Embedded DNS
# 1. docker-compose.yml을 실행하면 Docker는 별도의 가상 네트워크를 생성합니다.
# 2. 이 네트워크 안에 포함된 모든 컨테이너는 각자의 고유한 IP를 할당받는 동시에, 서비스 이름을 자신의 호스트 이름으로 등록합니다.
# 3. 애플리케이션 컨테이너가 POSTGRES_HOST=database를 사용해 접속을 시도할 때 내부적으로 일어나는 일은 아래와 같습니다.
#    - app 컨테이너의 DNS 리졸버가 'database'라는 호스트 이름을 쿼리합니다.
#    - Docker의 내장 DNS 서버가 이 이름을 해석하여, 해당 네트워크 내의 database 컨테이너에 할당된 실제 IP 주소를 반환합니다.
#    - app 컨테이너는 이 IP 주소로 TCP 연결을 시도하여 데이터베이스에 접속합니다.
# 컨테이너를 껐다 켜면 내부 IP 주소는 바뀔 수 있으나 서비스 이름(database)은 변하지 않기 때문입니다.
# POSTGRES_PORT: PostgreSQL 서버가 외부 접속을 수신하기 위해 열어두는 표준 통신 포트입니다.
POSTGRES_HOST=database
POSTGRES_PORT=5432

# [데이터베이스 인증 및 테이블 권한 정보]
# PostgreSQL 컨테이너가 최초 생성(기동)될 때 초기화하는 데이터베이스 이름과, 접근을 통제하기 위한 마스터 사용자 계정/비밀번호입니다.
# POSTGRES_DB: 회계 RAG의 벡터 데이터와 그래프 데이터를 저장할 기본 데이터베이스 스키마 이름입니다.
# POSTGRES_USER / POSTGRES_PASSWORD: 애플리케이션 코드가 데이터베이스의 테이블을 읽거나 쓰기 위해 권한을 증명하는 인증 수단입니다.
POSTGRES_DB=accounting_db
POSTGRES_USER=accounting_user
POSTGRES_PASSWORD=accounting_password_example

# [그래프 데이터베이스(Apache AGE) 설정]
# RAG 파이프라인에서 온톨로지 개념망(회계기준, 계정과목 위계, 문서 출처 등)을 논리적으로 분리하고 저장할 그래프의 식별자를 지정합니다.
# AGE_GRAPH_NAME: Cypher(그래프 쿼리 언어) 실행 시 수많은 그래프 공간 중 어떤 그래프를 타겟으로 조회할지 결정하는 데 쓰이는 고유 이름입니다.
AGE_GRAPH_NAME=accounting_graph

# [애플리케이션 전용 로깅 및 추가 설정]
# LOG_LEVEL: 애플리케이션에서 출력하는 터미널 메시지(디버깅 로그)의 상세도(INFO, DEBUG, ERROR)를 환경 변수만으로 손쉽게 조절하기 위해 마련된 플레이스홀더입니다.
# LOG_LEVEL=INFO

# [Reranking Configuration]
# USE_RERANKER: Cross-Encoder 리랭킹 모델 활성화 여부입니다.
#   - false(기본값): 1차 검색 결과를 그대로 사용하며 리랭킹 모델을 호출하지 않습니다.
#   - true: 검색 결과를 리랭킹 모델로 재정렬한 후 임계값 필터링을 수행합니다.
# RERANK_THRESHOLD: USE_RERANKER=true일 때 적용되는 리랭킹 점수 임계값입니다 (0.0 ~ 1.0)
#   최고 점수가 이 값 미만이면 재검색(CRAG 루프)을 트리거합니다.
USE_RERANKER=false
RERANK_THRESHOLD=0.5
