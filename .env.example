# [OpenAI API 설정]
# OPENAI_API_KEY: 온톨로지 빌더 및 LLM 클라이언트가 OpenAI API를 호출하기 위해 사용하는 인증 키입니다.
OPENAI_API_KEY=sk-your-key-here

# [데이터베이스 접속 정보]
# POSTGRES_HOST: DB 서버의 호스트 이름. 실행 위치에 따라 값이 다르다.
#   - 호스트에서 직접 실행(기본): localhost — ingest·query·벤치마크·uvicorn 등 대부분의 개발 작업이 이 경로다.
#   - 컨테이너(app) 안에서 실행: docker-compose.yml이 POSTGRES_HOST=database를 주입하므로 이 .env 값과 무관하다.
#     (compose가 만든 가상 네트워크 안에서 서비스 이름 'database'가 DB 컨테이너 IP로 자동 라우팅된다.)
# POSTGRES_PORT: PostgreSQL 서버가 외부 접속을 수신하기 위해 열어두는 표준 통신 포트입니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# [데이터베이스 인증 및 테이블 권한 정보]
# PostgreSQL 컨테이너가 최초 생성(기동)될 때 초기화하는 데이터베이스 이름과, 접근을 통제하기 위한 마스터 사용자 계정/비밀번호입니다.
# POSTGRES_DB: 회계 RAG의 벡터 데이터를 저장할 기본 데이터베이스 스키마 이름입니다.
# POSTGRES_USER / POSTGRES_PASSWORD: 애플리케이션 코드가 데이터베이스의 테이블을 읽거나 쓰기 위해 권한을 증명하는 인증 수단입니다.
POSTGRES_DB=accounting_db
POSTGRES_USER=accounting_user
POSTGRES_PASSWORD=accounting_password_example

# [컨테이너 포트 공개 범위 — docker-compose.yml]
# 세 컨테이너가 호스트의 "어느 주소"의 "어느 포트"에 열릴지를 정합니다.
# 바인딩 주소(BIND_ADDR)는 그 포트에 누가 접속할 수 있는지를 결정합니다.
#   - 127.0.0.1 (기본값, 루프백): 같은 컴퓨터 안에서만 닿습니다. 사설망의 다른 서버나 인터넷에서는 보이지 않습니다.
#   - 0.0.0.0: 호스트의 모든 네트워크 인터페이스에 엽니다. 방화벽이 막아 주기 전까지 외부에서 접속할 수 있습니다.
# 기본값을 루프백으로 둔 이유는 세 서비스 모두 바깥에서 직접 접속할 필요가 없기 때문입니다.
# 컨테이너끼리는 compose가 만든 가상 네트워크로 통신하고, 호스트에서 돌리는 적재 스크립트는 localhost로 붙습니다.
# 앞단에 nginx 같은 리버스 프록시를 두는 배포에서도 프록시가 localhost로 전달하므로 루프백이면 충분합니다.
# 포트 번호는 호스트 쪽 번호만 바꿉니다. 
# 예를 들어 APP_HOST_PORT=3000이면 컨테이너 안의 8000번이 호스트 3000번으로 노출되어 http://localhost:3000 으로 접속합니다.
# 이미 그 번호를 쓰는 프로그램이 있거나(포트 충돌), 클라우드 방화벽이 특정 번호만 허용할 때 바꿉니다.
# 값을 바꾸면 ./install.sh와 ./check.sh도 같은 값을 읽어 그 주소로 상태를 확인합니다.
DB_BIND_ADDR=127.0.0.1
DB_HOST_PORT=5432
EMBEDDING_BIND_ADDR=127.0.0.1
EMBEDDING_HOST_PORT=8080
APP_BIND_ADDR=127.0.0.1
APP_HOST_PORT=8000

# [애플리케이션 전용 로깅 및 추가 설정]
# LOG_LEVEL: 애플리케이션에서 출력하는 터미널 메시지(디버깅 로그)의 상세도(INFO, DEBUG, ERROR)를 환경 변수만으로 손쉽게 조절하기 위해 마련된 플레이스홀더입니다.
# LOG_LEVEL=INFO

# [Reranking Configuration]
# USE_RERANKER: Cross-Encoder 리랭킹 모델 활성화 여부입니다.
#   - false(기본값): 1차 검색 결과를 그대로 사용하며 리랭킹 모델을 호출하지 않습니다.
#   - true: 검색 결과를 리랭킹 모델로 재정렬한 후 임계값 필터링을 수행합니다. 컨테이너에서 켜려면
#     리랭커 의존성이 필요합니다 — 이미지를 `uv sync ... --extra reranker`로 재빌드하십시오(기본 이미지엔 없음).
#   실측상 어떤 리랭커도 dense 단독 Hit@1을 못 넘어 기본은 OFF입니다(docs/measurements 참고). opt-in은 실험용.
# RERANK_THRESHOLD: USE_RERANKER=true일 때 적용되는 리랭킹 점수 임계값입니다 (0.0 ~ 1.0)
#   최고 점수가 이 값 미만이면 재검색(CRAG 루프)을 트리거합니다.
# RERANK_MODEL: 리랭킹에 사용할 Cross-Encoder 모델 식별자입니다. 미설정 시 기본값을 사용합니다.
#   기본값은 한국어 지원 모델(BAAI/bge-reranker-v2-m3)입니다 — ms-marco는 512토큰 한도라 한국어 청크에서 무용.
USE_RERANKER=false
RERANK_THRESHOLD=0.5
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# [Hybrid Search Fusion]
# SPARSE_FUSION_WEIGHT: 하이브리드 검색 병합(RRF)에서 sparse(형태소 키워드) 결과에 주는 가중치입니다 (dense는 1.0 고정).
#   기본값 0.1은 실측 채택 수치입니다(docs/benchmark/sparse_morph_replay_20260725_2205.md).
#   1.0으로 올리면 대칭 병합이 되어 키워드 일치 청크가 상위로 잘 오르는 대신, dense가 1위로 잡아 둔 정답 조항이 밀려나는 회귀가 실측에서 크게 늘었습니다(순증−회귀 +5 → −9).
# SPARSE_FUSION_WEIGHT=0.1

# [임베딩 서빙 분리 — docker `embedding` 서비스(TEI, KURE-v1)]
# EMBEDDING_SERVER_URL: 설정 시 임베딩(embed_texts)·토큰 계산(count_tokens)을 src/client를 통해
#   해당 서빙 서버로 HTTP 위임합니다. 미설정(기본)이면 프로세스 내 로드(호스트 MPS 사용 가능)로 동작합니다.
#   - app 컨테이너에서 실행 시: http://embedding:80  (docker-compose.yml이 주입)
#   - 호스트에서 uvicorn을 직접 실행하고 TEI를 쓸 때: http://localhost:8080
#   - 미설정으로 로컬 모델을 직접 로드할 때: uv sync --extra local-embedding 필요
#   - PDF 파싱 ingest 경로는 별도로 uv sync --extra ingest 필요
# EMBEDDING_SERVER_TIMEOUT_SECONDS: 서빙 서버 호출 타임아웃(기본 120초).
# EMBEDDING_SERVER_URL=http://localhost:8080

# [API 서버 CORS]
# API_CORS_ORIGINS: FastAPI 서버(src/api/server.py)가 허용할 브라우저 origin 목록(콤마 구분)입니다.
#   미설정 시 React dev 서버(Vite) 기본값을 사용합니다: http://localhost:5173,http://127.0.0.1:5173
# API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# [원본 PDF 소재 디렉토리 — BYO]
# PDF_DIR: 페이지 백필(scripts/backfill_page_map.py)과 원문 PDF 서빙이 참조하는 디렉토리입니다.
#   {PDF_DIR}/{document_id}.pdf 를 우선 찾고, 없으면 제N장*.pdf 글롭으로 매핑합니다. 미설정 시 data/raw_data.
# PDF_DIR=data/raw_data

# [LangSmith 트레이싱 — 개발자 디버깅용, 기본 OFF 옵트인]
# 케이스별 파이프라인 노드 흐름·입출력·지연을 LangSmith로 추적하기 위한 설정입니다(#164).
# 아래 키가 없거나 LANGCHAIN_TRACING_V2가 true가 아니면 트레이싱은 비활성이며 파이프라인은 정상 동작합니다.
# 주의: 활성화 시 질의·LLM 답변·검색 컨텍스트가 외부 SaaS(LangSmith)로 전송됩니다. API 키는 레포에 커밋하지 마십시오.
# LANGCHAIN_TRACING_V2: true로 설정해야 LangGraph 노드 단위 트레이스가 기록됩니다.
# LANGCHAIN_API_KEY: LangSmith API 키(시크릿). 부재 시 트레이싱은 그대로 비활성.
# LANGCHAIN_PROJECT: 트레이스가 모일 프로젝트명(미지정 시 LangSmith 기본 프로젝트).
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-your-key-here
# LANGCHAIN_PROJECT=rag-for-accounting
