{
  "version": "1.0.0",
  "description": "is_accounting_query 분류 정확도 측정용 경계 질의 표본 데이터셋입니다. CLASSIFY_STRATEGY_PROMPT 기준에 따라 레이블링하였습니다.",
  "schema": {
    "id": "표본 고유 식별자",
    "query": "사용자 질의 원문",
    "expected_is_accounting": "정답 레이블 (true: 회계 질의, false: 비회계 질의)",
    "category": "질의 유형 분류 (clear_accounting | clear_non_accounting | boundary)",
    "note": "레이블 근거 또는 모호성 이유 (선택 항목)"
  },
  "samples": [
